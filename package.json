{
  "name": "office-arcade",
  "version": "3.6.2",
  "private": true,
  "description": "摸鱼游戏厅 — 内网联机小游戏平台：注册登录、在线状态、房间与人机、6 款游戏、管理后台、SQLite 战绩",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "lan": "node server.js 8090 --open",
    "test": "node tools/words-test.js && node tools/game-test.js && node tools/bot-test.js",
    "test:all": "node tools/test-all.js",
    "test:all:ui": "node tools/test-all.js --with-ui",
    "test:check": "node tools/check.js",
    "test:words": "node tools/words-test.js",
    "test:auth": "node tools/auth-test.js",
    "test:player": "node tools/player-profile-test.js",
    "test:proxy": "node tools/proxy-test.js",
    "test:audit": "node tools/audit-test.js",
    "test:hardening": "node tools/hardening-test.js",
    "test:regression": "node tools/regression-test.js",
    "test:perf": "node tools/perf-test.js",
    "test:ui": "node tools/ui-v2-test.js && node tools/ui-v3-test.js && node tools/ui-v4-test.js && node tools/ui-v5-test.js && node tools/ui-v6-test.js && node tools/ui-v7-test.js && node tools/ui-v8-test.js && node tools/ui-v9-test.js",
    "bump": "node tools/bump-version.js",
    "version:show": "node tools/bump-version.js --show",
    "test:admin": "node tools/admin-test.js && node tools/admin-words-ui-test.js",
    "test:offline": "node tools/offline-test.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "game",
    "lan",
    "websocket",
    "arcade",
    "multiplayer",
    "sqlite",
    "bots"
  ],
  "license": "MIT"
}
